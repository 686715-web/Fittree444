<!DOCTYPE html>
<html lang="th" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบตรวจจับและเฝ้าระวังแก๊สรั่วไหลอัจฉริยะ (Smart Gas Detection System)</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: { slate: { 850: '#111827', 950: '#030712' } },
                    fontFamily: { prompt: ['Prompt', 'sans-serif'] },
                    animation: {
                        'glow-red': 'glowRed 1.5s infinite alternate',
                    },
                    keyframes: {
                        glowRed: {
                            '0%': { boxShadow: '0 0 5px rgba(244, 63, 94, 0.4)' },
                            '100%': { boxShadow: '0 0 25px rgba(244, 63, 94, 0.9)' }
                        }
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Chart.js & Firebase SDK -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>

    <style>
        body { font-family: 'Prompt', sans-serif; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-rose-500 selection:text-white pb-12">

    <!-- HEADER -->
    <header class="bg-slate-900/90 border-b border-slate-800 backdrop-blur-md sticky top-0 z-40 px-4 lg:px-8 py-3.5 shadow-2xl">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
            
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-gradient-to-tr from-rose-600 via-amber-500 to-emerald-500 rounded-xl shadow-lg text-slate-950">
                    <i class="fa-solid font-black fa-wind text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg md:text-xl font-bold text-white flex items-center gap-2">
                        ระบบตรวจจับและเฝ้าระวังแก๊สรั่วไหลอัจฉริยะ
                        <span class="text-xs font-normal text-slate-400 hidden sm:inline-block px-2 py-0.5 rounded bg-slate-800 border border-slate-700">v3.4 IoT Pro</span>
                    </h1>
                    <p class="text-xs text-slate-400">Smart Industrial Gas Detection & Monitoring System</p>
                </div>
            </div>

            <div class="flex items-center flex-wrap justify-center gap-3">
                <!-- Status Badge -->
                <div id="overall-status-badge" class="flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-400 text-sm font-semibold shadow-lg">
                    <span class="relative flex h-3 w-3">
                        <span id="status-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span id="status-dot" class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                    </span>
                    <span id="status-text">สถานะระบบ: ปกติ (Safe)</span>
                </div>

                <!-- Clock -->
                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700/60 text-xs font-mono text-slate-300">
                    <i class="fa-regular fa-clock text-emerald-400"></i>
                    <span id="realtime-clock">--:--:--</span>
                </div>

                <!-- Firebase Status -->
                <div id="firebase-status" class="flex items-center gap-1.5 text-xs text-emerald-400 bg-emerald-950/30 border border-emerald-800/40 px-3 py-1.5 rounded-lg">
                    <i class="fa-solid fa-database animate-pulse"></i>
                    <span id="firebase-text">Firebase Syncing</span>
                </div>

                <!-- Mute Audio -->
                <button onclick="toggleAudioMute()" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-medium cursor-pointer">
                    <i id="audio-icon" class="fa-solid fa-volume-high text-emerald-400"></i>
                    <span id="audio-text">เปิดเสียงเตือน</span>
                </button>
            </div>
        </div>
    </header>

    <!-- CONTENT -->
    <main class="max-w-7xl mx-auto w-full px-4 lg:px-8 mt-6 flex-1 flex flex-col gap-6">

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Main Meter Card -->
            <div id="main-meter-card" class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col justify-between transition-all duration-500">
                <div>
                    <div class="flex justify-between items-center mb-4">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">ค่าระดับแก๊สปัจจุบัน (MQ-2)</span>
                        <span class="text-xs font-mono bg-slate-800 border border-slate-700 text-slate-300 px-2.5 py-1 rounded-md">GPIO36 / VP</span>
                    </div>

                    <div class="text-center py-6">
                        <div id="gas-value-display" class="text-6xl md:text-7xl font-extrabold font-mono text-emerald-400 tracking-tight transition-colors duration-300">
                            0
                        </div>
                        <div class="text-xs text-slate-400 mt-2">อนาล็อกเซนเซอร์ (0 - 4095 RAW)</div>
                    </div>

                    <div class="space-y-1.5 my-4">
                        <div class="flex justify-between text-xs font-mono text-slate-400">
                            <span>0</span>
                            <span>เกณฑ์เตือนภัย: <strong class="text-amber-400">1200</strong></span>
                            <span>4095</span>
                        </div>
                        <div class="w-full h-3 bg-slate-800 rounded-full overflow-hidden p-0.5 border border-slate-700">
                            <div id="gas-progress-bar" class="h-full bg-emerald-500 rounded-full transition-all duration-300 w-0"></div>
                        </div>
                    </div>
                </div>

                <div class="bg-slate-950/60 rounded-xl p-4 border border-slate-800 mt-4 flex items-center justify-between">
                    <div>
                        <div class="text-[11px] text-slate-400">การแจ้งเตือน Buzzer</div>
                        <div id="buzzer-status-text" class="text-sm font-semibold text-emerald-400">พร้อมทำงาน (Standby)</div>
                    </div>
                    <div id="buzzer-icon-container" class="p-3 bg-slate-800 rounded-lg text-slate-400">
                        <i class="fa-solid fa-bell text-lg"></i>
                    </div>
                </div>
            </div>

            <!-- Realtime Chart -->
            <div class="lg:col-span-2 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col justify-between">
                <div class="flex justify-between items-center mb-4">
                    <div>
                        <h2 class="text-base font-semibold text-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-chart-line text-sky-400"></i>
                            กราฟแสดงแนวโน้มความเข้มข้นแก๊สแบบเรียลไทม์ (Live Telemetry)
                        </h2>
                        <p class="text-xs text-slate-400">บันทึกประวัติการเปลี่ยนแปลงค่าเซนเซอร์ทุก 2 วินาที</p>
                    </div>
                    <span class="text-xs font-mono text-sky-400 bg-sky-950/50 border border-sky-800/50 px-2.5 py-1 rounded-md">Live Stream</span>
                </div>

                <div class="relative h-64 w-full">
                    <canvas id="gasChart"></canvas>
                </div>
            </div>

        </div>

        <!-- Event Log -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-semibold text-slate-200 flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-indigo-400"></i>
                    ประวัติเหตุการณ์และการเตือนภัย (Event Log)
                </h3>
                <button onclick="clearLogs()" class="text-xs text-slate-400 hover:text-rose-400 transition cursor-pointer">
                    <i class="fa-solid fa-trash-can mr-1"></i> ล้างประวัติ
                </button>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs font-mono">
                    <thead class="bg-slate-950 text-slate-400 uppercase text-[10px] border-b border-slate-800">
                        <tr>
                            <th class="py-2.5 px-4">เวลา (Time)</th>
                            <th class="py-2.5 px-4">ค่าแก๊ส (Value)</th>
                            <th class="py-2.5 px-4">สถานะ (Status)</th>
                            <th class="py-2.5 px-4">การตอบสนองระบบ (System Action)</th>
                        </tr>
                    </thead>
                    <tbody id="event-log-body" class="divide-y divide-slate-800/50 text-slate-300"></tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- JS & FIREBASE REALTIME -->
    <script>
        const firebaseConfig = { databaseURL: "https://fittreemauhihi-default-rtdb.firebaseio.com" };
        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();

        const THRESHOLD = 1200;
        let isMuted = false;
        let audioCtx = null;
        let alarmOscillator = null;

        // Initialize Chart.js
        const ctx = document.getElementById('gasChart').getContext('2d');
        const gasChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'ระดับแก๊ส (Gas Value)',
                    data: [],
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { grid: { color: 'rgba(51, 65, 85, 0.3)' }, ticks: { color: '#94a3b8' } },
                    y: { min: 0, max: 4095, grid: { color: 'rgba(51, 65, 85, 0.3)' }, ticks: { color: '#94a3b8' } }
                },
                plugins: { legend: { display: false } }
            }
        });

        // Firebase Realtime Listener
        const gasRef = database.ref('/Gas_Detector');
        gasRef.on('value', (snapshot) => {
            const data = snapshot.val();
            if (data !== null) {
                const gasValue = data.gas_value !== undefined ? data.gas_value : 0;
                const status = data.status || (gasValue > THRESHOLD ? "DANGER" : "NORMAL");
                updateUI(gasValue, status);
            }
        });

        function updateUI(gasValue, status) {
            const now = new Date();
            const timeStr = now.toTimeString().split(' ')[0];

            document.getElementById('gas-value-display').innerText = gasValue;
            
            const percent = Math.min(Math.max((gasValue / 4095) * 100, 0), 100);
            document.getElementById('gas-progress-bar').style.width = percent + '%';

            const isDanger = gasValue > THRESHOLD || status === "DANGER";

            const displayElem = document.getElementById('gas-value-display');
            const mainCard = document.getElementById('main-meter-card');
            const badge = document.getElementById('overall-status-badge');
            const statusText = document.getElementById('status-text');
            const buzzerText = document.getElementById('buzzer-status-text');
            const buzzerIcon = document.getElementById('buzzer-icon-container');

            if (isDanger) {
                displayElem.className = "text-6xl md:text-7xl font-extrabold font-mono text-rose-500 tracking-tight animate-pulse";
                document.getElementById('gas-progress-bar').className = "h-full bg-rose-500 rounded-full transition-all duration-300";
                mainCard.className = "bg-slate-900/90 border border-rose-500/50 rounded-2xl p-6 shadow-2xl animate-glow-red transition-all duration-500";
                
                badge.className = "flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-rose-950/80 border border-rose-500/40 text-rose-400 text-sm font-semibold";
                statusText.innerText = "สถานะระบบ: วิกฤต (DANGER)";

                buzzerText.innerText = "เตือนภัย! Buzzer กำลังดัง";
                buzzerText.className = "text-sm font-semibold text-rose-400 animate-pulse";
                buzzerIcon.className = "p-3 bg-rose-950 text-rose-400 border border-rose-800 rounded-lg animate-bounce";

                playAlarmSound(true);
                addLogEntry(timeStr, gasValue, "DANGER", "เปิดสัญญาณเตือน Buzzer");
            } else {
                displayElem.className = "text-6xl md:text-7xl font-extrabold font-mono text-emerald-400 tracking-tight";
                document.getElementById('gas-progress-bar').className = "h-full bg-emerald-500 rounded-full transition-all duration-300";
                mainCard.className = "bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col justify-between transition-all duration-500";

                badge.className = "flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-400 text-sm font-semibold";
                statusText.innerText = "สถานะระบบ: ปกติ (Safe)";

                buzzerText.innerText = "พร้อมทำงาน (Standby)";
                buzzerText.className = "text-sm font-semibold text-emerald-400";
                buzzerIcon.className = "p-3 bg-slate-800 rounded-lg text-slate-400";

                playAlarmSound(false);
            }

            updateChart(timeStr, gasValue, isDanger);
        }

        function updateChart(timeLabel, value, isDanger) {
            gasChart.data.labels.push(timeLabel);
            gasChart.data.datasets[0].data.push(value);

            gasChart.data.datasets[0].borderColor = isDanger ? '#f43f5e' : '#10b981';
            gasChart.data.datasets[0].backgroundColor = isDanger ? 'rgba(244, 63, 94, 0.15)' : 'rgba(16, 185, 129, 0.1)';

            if (gasChart.data.labels.length > 20) {
                gasChart.data.labels.shift();
                gasChart.data.datasets[0].data.shift();
            }

            gasChart.update();
        }

        let lastLoggedState = "";
        function addLogEntry(time, value, status, action) {
            if (lastLoggedState === status) return;
            lastLoggedState = status;

            const tbody = document.getElementById('event-log-body');
            const row = document.createElement('tr');
            row.className = status === "DANGER" ? "bg-rose-950/30 text-rose-300 font-semibold" : "hover:bg-slate-800/40";

            row.innerHTML = `
                <td class="py-2.5 px-4">${time}</td>
                <td class="py-2.5 px-4">${value} RAW</td>
                <td class="py-2.5 px-4"><span class="bg-rose-950 text-rose-400 border border-rose-800 px-2 py-0.5 rounded">${status}</span></td>
                <td class="py-2.5 px-4">${action}</td>
            `;

            tbody.insertBefore(row, tbody.firstChild);
            if (tbody.children.length > 10) tbody.removeChild(tbody.lastChild);
        }

        function clearLogs() {
            document.getElementById('event-log-body').innerHTML = '';
            lastLoggedState = "";
        }

        function toggleAudioMute() {
            isMuted = !isMuted;
            document.getElementById('audio-text').innerText = isMuted ? "ปิดเสียงอยู่" : "เปิดเสียงเตือน";
            document.getElementById('audio-icon').className = isMuted ? "fa-solid fa-volume-xmark text-rose-400" : "fa-solid fa-volume-high text-emerald-400";
            if (isMuted) playAlarmSound(false);
        }

        function playAlarmSound(play) {
            if (isMuted || !play) {
                if (alarmOscillator) { alarmOscillator.stop(); alarmOscillator = null; }
                return;
            }
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (!alarmOscillator) {
                alarmOscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                alarmOscillator.type = 'sawtooth';
                alarmOscillator.frequency.setValueAtTime(880, audioCtx.currentTime);
                gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
                alarmOscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                alarmOscillator.start();
            }
        }

        setInterval(() => {
            document.getElementById('realtime-clock').innerText = new Date().toTimeString().split(' ')[0];
        }, 1000);
    </script>
</body>
</html>
